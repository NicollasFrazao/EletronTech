{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nicollasfrazao/eletrontech",
    "type": "project",
    "description": "EletronTech v2: electrical calculators and a floor-plan editor for low-voltage residential projects (NBR 5410), rewritten in Laravel.",
    "keywords": [
        "laravel",
        "electrical",
        "nbr-5410",
        "calculators"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.23",
        "icanhazstring/composer-unused": "^0.9.8",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpmd/phpmd": "^3.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5.12",
        "povils/phpmnd": "^3.6",
        "rector/rector": "^2.8",
        "shipmonk/dead-code-detector": "^1.4",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0",
        "tomasvotruba/cognitive-complexity": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/pest"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/pest --coverage --min=80"
        ],
        "pint": "pint --test",
        "pint:fix": "pint",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=1G --no-progress",
        "phpmd": "phpmd analyze app database routes phpcs/EletronTech --format text --ruleset phpmd.xml --no-progress",
        "phpmnd": "phpmnd app database routes phpcs/EletronTech --extensions=all --exclude=migrations",
        "deptrac": "deptrac analyse --no-progress",
        "rector": "rector process --dry-run --no-progress-bar",
        "unused": "composer-unused --no-progress",
        "context:check": "@php artisan context:check",
        "context:export": "@php artisan context:export",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test:coverage": "Pest with the 80% line coverage gate (needs pcov)",
        "pint": "Code style check (Laravel preset), no changes written",
        "pint:fix": "Fix the code style in place",
        "phpcs": "Doc comments and readability limits Pint does not cover",
        "phpstan": "Larastan at max level, strict rules, cognitive complexity, dead code",
        "phpmd": "Unused code and size/complexity limits",
        "phpmnd": "Magic numbers",
        "deptrac": "Layer rules of docs/adr/0001-layered-architecture.md",
        "rector": "Pending upgrades and dead code, dry run",
        "unused": "Composer dependencies nothing uses",
        "context:check": "Agent surfaces are copies of .context/docs/README.md",
        "context:export": "Write the agent surfaces from .context/docs/README.md"
    }
}
